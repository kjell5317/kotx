# ─────────────────────────────────────────────────────────────────────────────
# kotx environment. Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- HTTP (app) ---
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://code.kjellhanken.de

# --- GitHub (personal account, PAT auth) ---
# Prefer a fine-grained PAT scoped to the allowlisted repos with these repo
# permissions: Contents (r/w), Issues (r/w), Pull requests (r/w), Metadata (r).
# Inline, or point GITHUB_TOKEN_FILE at a file. Used for REST API + git push/fetch.
GITHUB_TOKEN=
GITHUB_TOKEN_FILE=
# Set this same secret on each repo's webhook (Settings → Webhooks).
GITHUB_WEBHOOK_SECRET=
# git commit identity — your own name/email (the agent commits/opens PRs as you).
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=you@users.noreply.github.com

# --- Postgres ---
DATABASE_URL=postgres://kotx:kotx@postgres:5432/kotx

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Paths on the host (mounted into worker; bind-mounted into runner) ---
AGENT_DATA_DIR=/srv/agent
CODEX_HOME=/srv/agent/codex-home

# --- Container images (built + pushed by CI to GHCR) ---
# app + worker share one image; the worker launches the runner image.
# Replace the owner if the repo isn't under TUM-Social-AI.
KOTX_IMAGE=ghcr.io/kjell5317/kotx-app:latest
CODEX_RUNNER_IMAGE=ghcr.io/kjell5317/kotx-runner:latest
# Only needed if the GHCR packages are PRIVATE (worker pulls the runner image;
# `docker login ghcr.io` separately for compose to pull the app image). A PAT
# with read:packages works as GHCR_TOKEN.
GHCR_USERNAME=kjell5317
GHCR_TOKEN=

# --- Config files ---
CONFIG_DIR=./config

# --- Polling (for repos with poll: true in repos.yml) ---
# How often the app checks polled repos for labels + /agent commands.
POLL_INTERVAL_SEC=60

# --- Home Assistant notifications (optional; all three required to enable) ---
# Notifies on task start + finish, deep-linked to the issue/PR (or the
# triggering comment on a PR). Same per-task tag → start is replaced by finish.
HA_BASE_URL=https://homeassistant.example.com
HA_TOKEN=
# the notify service for your phone, i.e. the part after notify/
HA_NOTIFY_SERVICE=mobile_app_your_phone

# --- Web UI (runs dashboard at /ui) ---
# Required to enable the UI. Log in with any username and this value as the
# password (HTTP Basic). Unset = UI disabled (503).
UI_TOKEN=

# --- Logging ---
LOG_LEVEL=info
